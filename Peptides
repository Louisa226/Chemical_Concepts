/* ============================== BUILDER ============================== */
let picked = [], filter = 'all';
const SLOTS = 3;
 
function renderCards(){
  const grid = document.getElementById('pepGrid');
  if(!grid) return;
  grid.innerHTML = P.filter(p => filter === 'all' || p.cat === filter).map(p => {
    const on = picked.includes(p.id);
    const bg = p.cat==='growth'?'var(--brass-tint)':p.cat==='metabolic'?'var(--steel-tint)':'var(--teal-tint)';
    return `<article class="pep">
      <div class="top" style="background:${bg}">
        <span class="cat" style="color:${CATC[p.cat]}">${esc(p.catLabel)}</span>
        <h3><a href="#/peptide/${p.slug}" style="color:var(--teal-deep);text-decoration:none">${esc(p.name)}</a></h3>
        <div class="chain">${esc(p.chain)}</div>
        <div class="gwrap"><span class="grade g-${p.grade}">${esc(p.gradeLabel)}</span></div>
      </div>
      <div class="bd">
        <div class="fld"><label>Mimics / derives from</label><p><span class="tagpill">${esc(p.mimics)}</span></p></div>
        <div class="fld"><label>Receptor target</label><p>${esc(p.receptor)}</p></div>
        <div class="fld"><label>In brief</label><p>${esc(p.tagline)}</p></div>
        <div class="row">
          <a class="more" href="#/peptide/${p.slug}">Full page <span aria-hidden="true">\u2192</span></a>
          <button class="add" data-id="${p.id}" aria-pressed="${on}">${on?'\u2713 In builder':'+ Add to builder'}</button>
        </div>
      </div>
    </article>`;
  }).join('');
  grid.querySelectorAll('.add').forEach(b => b.onclick = () => toggle(b.dataset.id));
}
 
function toggle(id){
  if(picked.includes(id)) picked = picked.filter(x => x !== id);
  else { if(picked.length >= SLOTS) picked.shift(); picked.push(id); }
  renderCards(); renderSlots(); renderPanel();
}
 
function renderSlots(){
  const el = document.getElementById('slots');
  if(!el) return;
  let h = '';
  for(let i = 0; i < SLOTS; i++){
    const p = byId(picked[i]);
    h += p
      ? `<div class="slot on"><span class="sl">Slot ${i+1}</span><span class="sn">${esc(p.name)}</span><span class="ss">${esc(p.catLabel)}</span><button class="rm" data-id="${p.id}">Remove</button></div>`
      : `<div class="slot"><span class="sl">Slot ${i+1}</span><span class="se">Empty \u2014 add a peptide from the library above.</span></div>`;
  }
  el.innerHTML = h;
  el.querySelectorAll('.rm').forEach(b => b.onclick = () => toggle(b.dataset.id));
}
 
function renderPanel(){
  const el = document.getElementById('panel');
  if(!el) return;
  if(picked.length < 2){
    el.innerHTML = '<h4>Pathway analysis</h4><p class="p-empty">Add at least two peptides to compare their mechanisms.</p>';
    return;
  }
  let out = '';
  for(let i = 0; i < picked.length; i++) for(let j = i+1; j < picked.length; j++){
    const a = byId(picked[i]), b = byId(picked[j]);
    const rec = PAIRS[[a.id,b.id].sort().join('|')] || ["independent","No documented mechanistic interaction."];
    const [label, cls] = VERDICT[rec[0]];
    out += `<div class="sl-line"><span class="d">\u25C6</span><span><span class="vd ${cls}">${label}</span><strong>${esc(a.name)} \u00D7 ${esc(b.name)}</strong> \u2014 ${esc(rec[1])}</span></div>`;
  }
  const sema = picked.includes('semaglutide');
  el.innerHTML = '<h4>Pathway analysis</h4>' + out +
    `<p class="p-foot">Mechanistic comparison only \u2014 not a formulation, ratio, or protocol.${sema?' Semaglutide is a prescription medicine: interaction questions about it belong with your prescriber or pharmacist, who can check against everything else you take.':''}</p>`;
}
 
/* ============================== ROUTER ============================== */
function parseHash(){
  const raw = location.hash.replace(/^#/, '') || '/';
  const m = raw.match(/^\/peptide\/([a-z0-9-]+)/i);
  if(m) return {view:'detail', slug:m[1], anchor:''};
  const a = raw.match(/^\/?#?(.*)$/);
  return {view:'home', anchor:(a && a[1]) ? a[1] : ''};
}
 
function render(){
  const r = parseHash();
  const app = document.getElementById('app');
  if(r.view === 'detail'){
    const p = bySlug(r.slug);
    if(!p){ location.hash = '#/'; return; }
    app.innerHTML = detailView(p);
    document.title = p.name + ' \u2014 mechanism, homology & evidence | Peptide Pathways';
    window.scrollTo({top:0, behavior:'auto'});
  } else {
    app.innerHTML = homeView();
    document.title = 'Peptide Pathways \u2014 an academic reference on signaling peptides';
    document.querySelectorAll('.chip').forEach(c => c.onclick = () => {
      document.querySelectorAll('.chip').forEach(x => x.setAttribute('aria-pressed','false'));
      c.setAttribute('aria-pressed','true');
      filter = c.dataset.f;
      renderCards();
    });
    renderCards(); renderSlots(); renderPanel();
    if(r.anchor){
      const t = document.getElementById(r.anchor);
      if(t){ setTimeout(()=>t.scrollIntoView({behavior:'smooth',block:'start'}), 60); return; }
    }
    window.scrollTo({top:0, behavior:'auto'});
  }
}
 
